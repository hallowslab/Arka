ARKA_LOGDIR="/var/log/ARKA_LOGS"
ARKA_LOG_LEVEL="WARNING"
CELERY_RESULT_BACKEND="django-db"
CELERY_POOL=prefork
DJANGO_ENV="production"
DJANGO_SETTINGS_MODULE="arka.settings"
POSTGRES_USER="arka"
POSTGRES_PASSWORD="PASSWORD"
POSTGRES_DB="arka"
POSTGRES_HOST="arka-postgres"
POSTGRES_PORT=5432
RABBITMQ_DEFAULT_USER="arka"
RABBITMQ_DEFAULT_PASS="PASSWORD"
RABBITMQ_DEFAULT_VHOST="forj"
# /home/static in development, do not use app folder in dev gets ovverriden
STATIC_ROOT=/var/www/static
# These control the number of worker containers to run, forj and imapsync.  The default is 1, but you can increase this to scale up the number of workers.
# Optional, defaults to 1
FORJ_WORKER_REPLICAS=1
IMAPSYNC_WORKER_REPLICAS=1

# Modular apps (build-time: these control which modules are included in the Docker image)
# e.g. "AERA,PYMAP,DBTOOL,NETTOOLS,MIMIR,MXR,BIFROST"
ENABLED_APPS=""
# For enabling/skipping containers in docker-compose.yml trough the use of profiles
# e.g. "pymap,mimir" - required for their respective modular apps, otherwise there are no queues to process the tasks.
# Can also pass:
# - "tools" for pgadmin and rinsight
# - "dovecot" for local mail servers to test pymap
# - "monitor" for prometheus and it's exporters
# - monitor-dashboard for grafana
COMPOSE_PROFILES=""
# "git" = from GitHub (production), "local" = from src/modular_apps/ (testing)
MODULE_SOURCE=git

# Monitoring
PGADMIN_DEFAULT_EMAIL="pgadmin@arka.internal"
PGADMIN_DEFAULT_PASSWORD="PASSWORD"
